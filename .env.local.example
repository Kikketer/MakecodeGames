NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
INGEST_SECRET=
# MakeCodeGamesIngest Chromebook server (compile + ingest endpoints).
# Used by the /compilers pages and the GitHub Actions ingest workflows.
INGEST_URL=https://makecode.touchtypeordie.com
# Cloudflare Access service-token headers for the Chromebook tunnel.
# In GitHub Actions these come from the CLOUDFLARE_CLIENT var and
# CLOUDFLARE_SECRET secret; set them locally to test the compile proxy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_WRITE_API_KEY=
GEMINI_API_KEY=
# Turnstile — intentionally NOT set in .env.local (localhost skips verification).
# Set these only in Vercel env for production.
# NOTE: even if you copy NEXT_PUBLIC_TURNSTILE_SITE_KEY here for local
# testing, the widget is skipped on localhost hostnames (see
# lib/turnstile-client.ts) so compile/extension forms stay unblocked.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
